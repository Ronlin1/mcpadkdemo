# Gemini API key used by Google ADK
GOOGLE_API_KEY=YOUR_GEMINI_API_KEY

# Separate key for Google Developer Knowledge MCP
DEVELOPER_KNOWLEDGE_API_KEY=YOUR_DEVELOPER_KNOWLEDGE_API_KEY

# Model
MODEL=gemini-3.8-flash

# safe = local deterministic Workspace-like MCP servers
# real = Google Workspace MCP endpoints (requires eligible access + OAuth)
MODE=safe

# Demo failure switches
CHAOS_CALENDAR=0
CALENDAR_LATENCY_MS=0

# Real-mode OAuth token file
WORKSPACE_TOKEN_FILE=.workspace_token.json

# Keep Gemini on the Gemini API backend for this demo
GOOGLE_GENAI_USE_ENTERPRISE=0
